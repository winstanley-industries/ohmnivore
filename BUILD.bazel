package(default_visibility = ["//visibility:private"])

exports_files(
    [
        ".bazelrc",
        ".bazelversion",
        "BUILD.bazel",
        "MODULE.bazel",
        "MODULE.bazel.lock",
        "README.md",
        "docs/BUILDING.md",
        "docs/adr/ADR-001-cpp-cuda-migration.md",
        "docs/roadmap.md",
    ],
    visibility = ["//cuda:__pkg__"],
)

config_setting(
    name = "asan_enabled",
    flag_values = {"@llvm//config:asan": "True"},
)

config_setting(
    name = "ubsan_enabled",
    flag_values = {"@llvm//config:ubsan": "True"},
)

alias(
    name = "ohmnivore",
    actual = "//cpp:ohmnivore",
    visibility = ["//visibility:public"],
)

test_suite(
    name = "phase1_test",
    tags = ["manual"],
    tests = ["//cpp:phase1_test"],
    visibility = ["//visibility:public"],
)

test_suite(
    name = "cuda_smoke_test",
    tags = ["manual"],
    tests = ["//cuda:smoke_test"],
    visibility = ["//visibility:public"],
)

test_suite(
    name = "gpu02_cuda_test",
    tags = ["manual"],
    tests = [
        "//cuda:gpu02_linkage_test",
        "//cuda:gpu02_prepared_ac_test",
        "//cuda:gpu02_replay_differential_test",
    ],
    visibility = ["//visibility:public"],
)
