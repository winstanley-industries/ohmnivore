+__device__ double TriangularRow(const Shared &s, int begin, int end,
+                                double value) {
+  // Prefetch independent operands, retaining the original ordered FP64 FMAs.
+  constexpr int Width = 4;
+  int j = begin;
+  for (; j + Width <= end; j += Width) {
+    double coefficient[Width], operand[Width];
+#pragma unroll
+    for (int k = 0; k < Width; ++k) {
+      coefficient[k] = s.factor[j + k];
+      operand[k] = s.triangular[s.factor_columns[j + k]];
+    }
+#pragma unroll
+    for (int k = 0; k < Width; ++k)
+      value = fma(-coefficient[k], operand[k], value);
+  }
+  for (; j < end; ++j)
+    value = fma(-s.factor[j], s.triangular[s.factor_columns[j]], value);
+  return value;
+}
