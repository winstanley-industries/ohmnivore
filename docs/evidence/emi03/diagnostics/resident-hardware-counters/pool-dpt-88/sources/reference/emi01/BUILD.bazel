load("@rules_python//python:defs.bzl", "py_binary", "py_library", "py_test")

package(default_visibility = ["//visibility:private"])

exports_files(["requirements.txt"])

SANITIZER_INCOMPATIBILITY = select({
    "//:asan_enabled": ["@platforms//:incompatible"],
    "//conditions:default": [],
}) + select({
    "//:ubsan_enabled": ["@platforms//:incompatible"],
    "//conditions:default": [],
})

py_library(
    name = "support",
    visibility = ["//reference/emi02:__pkg__", "//reference/emi03:__pkg__", "//cpp:__pkg__"],
    srcs = [
        "adapter.py",
        "circuits.py",
        "metrics.py",
        "report.py",
        "signals.py",
        "study.py",
    ],
    data = [
        "BUILD.bazel",
        "CPU_GAPS.md",
        "MODEL_PROVENANCE.md",
        "README.md",
        "manifest-v2.json",
        "manifest.json",
        "requirements.txt",
        "//:emi01_provenance_inputs",
        "//third_party/emi_python:provenance_inputs",
        "//third_party/ngspice:provenance_inputs",
    ],
    deps = ["//third_party/emi_python:runtime"],
)

py_binary(
    name = "study",
    srcs = ["study.py"],
    args = [
        "--ngspice=$(rootpath //third_party/ngspice:ngspice_binary)",
        "--model-archive=$(rootpath @emi01_microchip_model//file)",
    ],
    data = [
        "//third_party/ngspice:ngspice_binary",
        "@emi01_microchip_model//file",
    ],
    legacy_create_init = False,
    python_version = "3.12.13",
    target_compatible_with = SANITIZER_INCOMPATIBILITY,
    deps = [":support"],
)

py_test(
    name = "signals_test",
    srcs = ["signals_test.py"],
    legacy_create_init = False,
    python_version = "3.12.13",
    deps = [":support"],
)

py_test(
    name = "adapter_test",
    srcs = ["adapter_test.py"],
    args = [
        "--ngspice=$(rootpath //third_party/ngspice:ngspice_binary)",
        "--archive=$(rootpath @emi01_microchip_model//file)",
    ],
    data = [
        "//third_party/ngspice:ngspice_binary",
        "@emi01_microchip_model//file",
    ],
    legacy_create_init = False,
    python_version = "3.12.13",
    target_compatible_with = SANITIZER_INCOMPATIBILITY,
    deps = [":support"],
)

py_test(
    name = "study_test",
    size = "small",
    srcs = ["study_test.py"],
    legacy_create_init = False,
    python_version = "3.12.13",
    deps = [":support"],
)

py_test(
    name = "metrics_test",
    srcs = ["metrics_test.py"],
    legacy_create_init = False,
    python_version = "3.12.13",
    deps = [":support"],
)

py_binary(
    name = "report",
    srcs = ["report.py"],
    legacy_create_init = False,
    python_version = "3.12.13",
    deps = [":support"],
)

py_test(
    name = "report_test",
    size = "small",
    srcs = ["report_test.py"],
    legacy_create_init = False,
    python_version = "3.12.13",
    deps = [":support"],
)
