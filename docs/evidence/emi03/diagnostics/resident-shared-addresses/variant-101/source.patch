+// These addresses refer only to scratch placed in shared memory by
+// Emi03Advance. Keep the ordered FP64 operations while avoiding generic loads.
+__device__ __forceinline__ double SharedDouble(unsigned address) {
+  double value;
+  asm volatile("ld.shared.f64 %0, [%1];"
+               : "=d"(value)
+               : "r"(address)
+               : "memory");
+  return value;
+}
+__device__ __forceinline__ int SharedInteger(unsigned address) {
+  int value;
+  asm volatile("ld.shared.s32 %0, [%1];"
+               : "=r"(value)
+               : "r"(address)
+               : "memory");
+  return value;
+}
+__device__ __forceinline__ void StoreSharedDouble(unsigned address,
+                                                  double value) {
+  asm volatile("st.shared.f64 [%0], %1;"
+               :
+               : "r"(address), "d"(value)
+               : "memory");
+}
+// A shared-address view for resident-only expression scratch. The standalone
+// expression executor retains its global pointers and the same AD arithmetic.
+struct SharedDoubleReference {
+  unsigned address;
+  __device__ operator double() const { return SharedDouble(address); }
+  __device__ SharedDoubleReference &operator=(double value) {
+    StoreSharedDouble(address, value);
+    return *this;
+  }
+  __device__ SharedDoubleReference &
+  operator=(const SharedDoubleReference &other) {
+    return *this = static_cast<double>(other);
+  }
+  __device__ SharedDoubleReference &operator+=(double value) {
+    return *this = SharedDouble(address) + value;
+  }
+};
+struct SharedDoubles {
+  unsigned address;
+  __device__ void Set(double *pointer) {
+    address = static_cast<unsigned>(__cvta_generic_to_shared(pointer));
+  }
+  __device__ SharedDoubleReference operator[](int index) const {
+    return {address + static_cast<unsigned>(index) * 8};
+  }
+};
+
 struct Pair {
   double time, value;
 };
