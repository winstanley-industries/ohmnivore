load("@rules_cc//cc:cc_shared_library.bzl", "cc_shared_library")
load("@rules_python//python:py_library.bzl", "py_library")
load("@rules_python//python:py_test.bzl", "py_test")
load(":runtime_rules.bzl", "reference_runtime")

filegroup(
    name = "provenance_inputs",
    srcs = [
        "BUILD.bazel",
        "PROVENANCE.md",
        "runtime.py",
        "runtime_rules.bzl",
    ],
    visibility = ["//reference/emi01:__pkg__"],
)

cc_shared_library(
    name = "zlib_runtime",
    shared_lib_name = "libz.so.1",
    deps = ["@zlib//:z"],
)

reference_runtime(
    name = "zlib_reference_runtime",
    library = ":zlib_runtime",
)

py_library(
    name = "runtime",
    srcs = ["runtime.py"],
    data = [
        ":zlib_reference_runtime",
        "@ohmnivore_cuda_gcc15//:lib64/libgcc_s.so.1",
        "@ohmnivore_cuda_gcc15//:lib64/libstdc++.so.6.0.34",
    ],
    visibility = ["//visibility:public"],
    deps = [
        "@emi01_pypi//numpy",
        "@rules_python//python/runfiles",
    ],
)

py_test(
    name = "runtime_test",
    size = "small",
    srcs = ["runtime_test.py"],
    legacy_create_init = 0,
    python_version = "3.12.13",
    deps = [":runtime"],
)
