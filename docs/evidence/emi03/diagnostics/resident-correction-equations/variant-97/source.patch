+// Recover the original, unshifted affine equation if a near-zero correction
+// cannot satisfy componentwise certification. This uses the same GPU Jacobian
+// and fresh current-state expression values; no tolerance is relaxed.
+__device__ void AbsoluteRhs(const Model &m, Workspace &w, Shared &s) {
+  for (int row = threadIdx.x; row < m.n; row += Threads) {
+    Sum affine;
+    affine.Add(w.companion_rhs[row]);
+    for (int k = s.matrix_rows[row]; k < s.matrix_rows[row + 1]; ++k) {
+      const int col = s.matrix_columns[k];
+      affine.Product(w.jacobian[k], w.current[col]);
+      affine.Product(-w.base[k], w.current[col]);
+    }
+    for (int k = m.expression_offsets[row]; k < m.expression_offsets[row + 1]; ++k) {
+      const auto stamp = m.expression_stamps[k];
+      affine.Product(-stamp.coefficient, w.expressions[stamp.program].value);
+    }
+    w.affine_rhs[row] = affine.Value();
+    if (!Bounded(w.affine_rhs[row]))
+      Reject(s, Nonfinite);
+  }
+  __syncthreads();
+}
