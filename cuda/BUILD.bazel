package(default_visibility = ["//visibility:private"])

# EMI-03 is a separate executable. Its semantic core has the same host
# controller and admission code; only its explicitly guarded backend hooks
# resolve to these CUDA translation units. Ordinary //cpp:core stays CPU-only.
EMI03_CPP_HEADERS = [
    "//cpp:include/ohmnivore/behavioral.h",
    "//cpp:include/ohmnivore/compiler.h",
    "//cpp:include/ohmnivore/expression.h",
    "//cpp:include/ohmnivore/ir.h",
    "//cpp:include/ohmnivore/nonlinear.h",
    "//cpp:include/ohmnivore/parser.h",
    "//cpp:include/ohmnivore/prepared_ac.h",
    "//cpp:include/ohmnivore/simulator.h",
    "//cpp:include/ohmnivore/solver.h",
    "//cpp:include/ohmnivore/sparse.h",
    "//cpp:include/ohmnivore/status.h",
    "//cpp:include/ohmnivore/transient.h",
    "//cpp:include/ohmnivore/waveform.h",
]

CUDA_SANITIZER_COMPATIBILITY = select({
    "//:asan_enabled": ["@platforms//:incompatible"],
    "//conditions:default": [],
}) + select({
    "//:ubsan_enabled": ["@platforms//:incompatible"],
    "//conditions:default": [],
})

cc_library(
    name = "emi03_cpp_headers",
    hdrs = EMI03_CPP_HEADERS,
    strip_include_prefix = "/cpp/include",
    tags = ["manual"],
    target_compatible_with = CUDA_SANITIZER_COMPATIBILITY,
)

cc_library(
    name = "emi03_interfaces",
    hdrs = ["emi03_expression.h", "emi03_real_solver.h", "emi03_resident.h"],
    tags = ["manual"],
    target_compatible_with = CUDA_SANITIZER_COMPATIBILITY,
    deps = [":emi03_cpp_headers"],
)

cc_library(
    name = "emi03_core",
    srcs = [
        "//cpp:src/behavioral.cc",
        "//cpp:src/compiler.cc",
        "//cpp:src/expression.cc",
        "//cpp:src/expression_internal.h",
        "//cpp:src/nonlinear.cc",
        "//cpp:src/nonlinear_internal.h",
        "//cpp:src/parser.cc",
        "//cpp:src/prepared_ac.cc",
        "//cpp:src/prepared_ac_internal.h",
        "//cpp:src/simulator.cc",
        "//cpp:src/solver.cc",
        "//cpp:src/transient.cc",
        "//cpp:src/waveform.cc",
    ],
    copts = ["-Wall", "-Werror", "-Wextra", "-Wpedantic"],
    local_defines = ["OHMNIVORE_EMI03_CUDA=1"],
    tags = ["manual"],
    target_compatible_with = CUDA_SANITIZER_COMPATIBILITY,
    deps = [":emi03_cpp_headers", ":emi03_interfaces", "@suitesparse_7_12_3//:klu"],
)

cuda_library(
    name = "emi03_cuda",
    srcs = ["emi03_expression.cu", "emi03_real_solver.cu", "emi03_resident.cu", "//cpp:src/expression_internal.h"],
    hdrs = ["emi03_cuda_internal.h", "emi03_expression_device.cuh", "emi03_reduction.cuh", "emi03_resident_device.cuh"],
    copts = [
        "-std=c++20",
        "--fmad=false",
        "-Xcompiler=-Wall",
        "-Xcompiler=-Werror",
        "-Xcompiler=-Wextra",
    ],
    tags = ["manual"],
    target_compatible_with = CUDA_SANITIZER_COMPATIBILITY,
    deps = [
        ":emi03_core",
        ":emi03_interfaces",
        "//third_party/cudss:cublas_static",
        "@cuda//:cuda_runtime_static",
        "@cudss_0_8_0_10_cuda13//:cudss_static",
    ],
)

cc_binary(
    name = "emi03_gpu_worker",
    srcs = ["//cpp:benchmarks/emi03_worker.cc", "//cpp:src/emi02_runner.cc"],
    copts = ["-Wall", "-Werror", "-Wextra", "-Wpedantic"],
    local_defines = ["OHMNIVORE_EMI03_CUDA=1", "OHMNIVORE_EMI03_WORKER=1"],
    tags = ["manual", "requires-gpu"],
    target_compatible_with = CUDA_SANITIZER_COMPATIBILITY,
    visibility = ["//visibility:public"],
    deps = [":emi03_cuda"],
)

cc_binary(
