load("@rules_cuda//cuda:defs.bzl", "cuda_library", "cuda_test")
load("@rules_cc//cc:cc_binary.bzl", "cc_binary")
load("@rules_cc//cc:cc_test.bzl", "cc_test")

package(default_visibility = ["//visibility:private"])

CUDA_SANITIZER_COMPATIBILITY = select({
    "//:asan_enabled": ["@platforms//:incompatible"],
    "//conditions:default": [],
}) + select({
    "//:ubsan_enabled": ["@platforms//:incompatible"],
    "//conditions:default": [],
})

GPU02_DEPS = [
    "//cpp:core",
    "//third_party/cudss:cublas_static",
    "@cuda//:cuda_runtime_static",
    "@cudss_0_8_0_10_cuda13//:cudss_static",
]

cuda_test(
    name = "smoke_test",
    size = "small",
    srcs = ["smoke_test.cu"],
    copts = ["-std=c++20"],
    tags = [
        "manual",
        "requires-gpu",
    ],
    target_compatible_with = CUDA_SANITIZER_COMPATIBILITY,
    visibility = ["//visibility:public"],
)

cuda_library(
    name = "prepared_ac_cuda",
    srcs = ["prepared_ac_cuda.cu"],
    hdrs = ["prepared_ac_cuda.h"],
    copts = [
        "-std=c++20",
        "-Xcompiler=-Wall",
        "-Xcompiler=-Werror",
        "-Xcompiler=-Wextra",
    ],
    tags = ["manual"],
    target_compatible_with = CUDA_SANITIZER_COMPATIBILITY,
    visibility = ["//visibility:public"],
    deps = GPU02_DEPS,
)

cc_test(
    name = "gpu02_prepared_ac_test",
    size = "small",
    srcs = [
        "gtest_main.cc",
        "prepared_ac_cuda_test.cc",
    ],
    copts = [
        "-std=c++20",
        "-Wall",
        "-Werror",
        "-Wextra",
        "-Wpedantic",
    ],
    tags = [
        "manual",
        "requires-gpu",
    ],
