package(default_visibility = ["//visibility:private"])

# GPU-02 reuses the frozen GPU-01 evidence implementation under a CUDA-only
# compile definition; ordinary CPU benchmark behavior remains unchanged.
exports_files(
    [
        "BUILD.bazel",
        "benchmarks/prepared_ac_replay.cc",
        "benchmarks/prepared_ac_replay.h",
        "benchmarks/prepared_ac_replay_benchmark.cc",
        "benchmarks/prepared_ac_session.cc",
        "benchmarks/prepared_ac_session.h",
        "include/ohmnivore/behavioral.h",
        "include/ohmnivore/expression.h",
        "include/ohmnivore/compiler.h",
        "include/ohmnivore/ir.h",
        "include/ohmnivore/nonlinear.h",
        "include/ohmnivore/parser.h",
        "include/ohmnivore/prepared_ac.h",
        "include/ohmnivore/simulator.h",
        "include/ohmnivore/solver.h",
        "include/ohmnivore/sparse.h",
        "include/ohmnivore/status.h",
        "include/ohmnivore/transient.h",
        "include/ohmnivore/waveform.h",
        "src/behavioral.cc",
        "src/expression.cc",
        "src/expression_internal.h",
        "src/compiler.cc",
        "src/nonlinear.cc",
        "src/nonlinear_internal.h",
