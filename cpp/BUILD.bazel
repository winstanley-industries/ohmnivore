cc_binary(
    name = "prepared_ac_replay_benchmark",
    testonly = True,
    srcs = ["benchmarks/prepared_ac_replay_benchmark.cc"],
    args = [
        "--corpus=$(rootpath //replays/prepared_ac/v1:corpus.csv)",
        "--source=$(rootpath :benchmarks/prepared_ac_replay_benchmark.cc)",
        "--source=$(rootpath :benchmarks/prepared_ac_replay.cc)",
        "--source=$(rootpath :benchmarks/prepared_ac_replay.h)",
        "--source=$(rootpath :src/prepared_ac.cc)",
        "--source=$(rootpath :include/ohmnivore/prepared_ac.h)",
        "--source=$(rootpath //replays/prepared_ac/v1:corpus.csv)",
    ],
    copts = OHMNIVORE_COPTS,
    data = [
        "benchmarks/prepared_ac_replay.cc",
        "benchmarks/prepared_ac_replay.h",
        "benchmarks/prepared_ac_replay_benchmark.cc",
        "include/ohmnivore/prepared_ac.h",
        "src/prepared_ac.cc",
        "//replays/prepared_ac/v1:corpus.csv",
    ],
    defines = ["OHMNIVORE_REPOSITORY_BAZEL_PIN=\\\"9.2.0\\\""],
    linkopts = ["-pthread"],
    tags = ["manual"],
    visibility = ["//visibility:public"],
    deps = [
        ":core",
        ":prepared_ac_replay",
    ],
)

