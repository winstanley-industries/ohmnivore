    size = "small",
    srcs = ["tests/solver_hermeticity_test.cc"],
    args = [
        "$(rootpath :ohmnivore)",
        "$(rootpath :production_solver_dependency_manifest)",
        "$(rootpath :production_solver_cc_manifest)",
    ],
    copts = OHMNIVORE_COPTS,
    data = [
        ":ohmnivore",
        ":production_solver_cc_manifest",
        ":production_solver_dependency_manifest",
    ],
    visibility = ["//visibility:public"],
    deps = ["@suitesparse_7_12_3//:klu"],
)

genquery(
    name = "production_solver_dependency_manifest",
    expression = "deps(//cpp:ohmnivore)",
    opts = [
        "--noimplicit_deps",
        "--notool_deps",
    ],
    scope = [":ohmnivore"],
)

solver_cc_boundary_manifest(
    name = "production_solver_cc_manifest",
    target = ":core",
)

cc_binary(
    name = "solver_selection_benchmark",
    srcs = ["benchmarks/solver_selection_benchmark.cc"],
    copts = OHMNIVORE_COPTS,
    defines = ["OHMNIVORE_REPOSITORY_BAZEL_PIN=\\\"9.2.0\\\""],
    tags = ["manual"],
    visibility = ["//visibility:public"],
    deps = [":core"],
)
