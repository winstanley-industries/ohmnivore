    srcs = [
        "tests/google_test.h",
        "tests/phase1_test.cc",
    ],
    copts = OHMNIVORE_COPTS,
    visibility = ["//visibility:public"],
    deps = [
        ":core",
        "@googletest//:gtest_main",
