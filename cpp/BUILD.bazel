load("@rules_cc//cc:cc_binary.bzl", "cc_binary")
load("@rules_cc//cc:cc_library.bzl", "cc_library")
load("@rules_cc//cc:cc_test.bzl", "cc_test")
load(":hermeticity.bzl", "solver_cc_boundary_manifest")

package(default_visibility = ["//visibility:private"])

OHMNIVORE_COPTS = [
    "-Wall",
    "-Werror",
    "-Wextra",
    "-Wpedantic",
]

cc_library(
    name = "core",
    srcs = [
        "src/compiler.cc",
        "src/nonlinear.cc",
        "src/nonlinear_internal.h",
        "src/parser.cc",
        "src/simulator.cc",
        "src/solver.cc",
        "src/transient.cc",
        "src/waveform.cc",
    ],
    hdrs = [
        "include/ohmnivore/compiler.h",
        "include/ohmnivore/ir.h",
        "include/ohmnivore/nonlinear.h",
        "include/ohmnivore/parser.h",
        "include/ohmnivore/simulator.h",
        "include/ohmnivore/solver.h",
        "include/ohmnivore/sparse.h",
        "include/ohmnivore/status.h",
        "include/ohmnivore/transient.h",
        "include/ohmnivore/waveform.h",
    ],
    copts = OHMNIVORE_COPTS,
    strip_include_prefix = "include",
    visibility = ["//visibility:public"],
    deps = ["@suitesparse_7_12_3//:klu"],
)

cc_library(
    name = "dense_oracle",
    testonly = True,
    srcs = ["tests/dense_oracle.cc"],
    hdrs = ["tests/dense_oracle.h"],
    copts = OHMNIVORE_COPTS,
    visibility = ["//cpp:__pkg__"],
    deps = [":core"],
)

cc_binary(
    name = "ohmnivore",
    srcs = ["src/main.cc"],
    copts = OHMNIVORE_COPTS,
    visibility = ["//visibility:public"],
    deps = [":core"],
)

